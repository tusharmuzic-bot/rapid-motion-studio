# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Public Site Canonical URL (update to your production URL on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-Time Admin Setup Secret (server-only; used only at /admin/setup when 0 admins exist)
ADMIN_SETUP_TOKEN=replace_with_a_strong_random_secret

# Optional: Enables server-side signed upload tokens and multi-admin invite creation
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Enables automatic acknowledgment emails when a client submits an inquiry
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=RAPID MOTION STUDIO <studio@yourdomain.com>
